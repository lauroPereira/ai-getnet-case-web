  "components": {
    "schemas": {
      "CompareRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^conv_[A-Za-z0-9]{8,40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "profile_id": {
            "type": "string",
            "title": "Profile Id"
          },
          "profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Profile Version"
          },
          "selected_mechanism": {
            "type": "string",
            "pattern": "^(llm|jev)$",
            "title": "Selected Mechanism"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "profile_id",
          "profile_version",
          "selected_mechanism"
        ],
        "title": "CompareRequest"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Handoff": {
        "properties": {
          "protocol": {
            "type": "string",
            "title": "Protocol"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "protocol",
          "reason"
        ],
        "title": "Handoff"
      },
      "MessageRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "Merchant message, in Portuguese or English."
          },
          "user_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-.]{1,64}$",
            "title": "User Id",
            "description": "Synthetic merchant identifier for the demo scenario. It does not prove identity."
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^conv_[A-Za-z0-9]{8,40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "user_id"
        ],
        "title": "MessageRequest",
        "examples": [
          {
            "message": "What's the difference between the Get Clássica and the Get Smart?",
            "user_id": "cliente1988"
          },
          {
            "message": "What's the weather forecast in Porto Alegre tomorrow?",
            "user_id": "cliente1988"
          },
          {
            "message": "When will the money from yesterday's sales be deposited?",
            "user_id": "cliente1988"
          },
          {
            "message": "Do I need a bank account to receive my sales via Pix?",
            "user_id": "cliente1988"
          },
          {
            "message": "My card machine won't connect to the internet, what should I do?",
            "user_id": "cliente1988"
          },
          {
            "message": "How does receivables advance (antecipação) work with Getnet?",
            "user_id": "cliente1988"
          },
          {
            "message": "What's the euro exchange rate today?",
            "user_id": "cliente1988"
          },
          {
            "message": "My card machine is showing a transaction decline error.",
            "user_id": "cliente1988"
          },
          {
            "message": "How many installments can I split a sale into with the crediário?",
            "user_id": "cliente1988"
          },
          {
            "message": "Can I sell through WhatsApp using the Payment Link?",
            "user_id": "cliente1988"
          }
        ]
      },
      "MessageResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "needs_clarification",
              "handoff",
              "refused"
            ],
            "title": "Status"
          },
          "route": {
            "type": "string",
            "enum": [
              "knowledge",
              "support",
              "knowledge_and_support",
              "general_web",
              "clarify",
              "human_handoff",
              "out_of_scope",
              "acknowledgement"
            ],
            "title": "Route"
          },
          "agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Agents"
          },
          "language": {
            "type": "string",
            "enum": [
              "pt",
              "en"
            ],
            "title": "Language"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution"
          },
          "handoff": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Handoff"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "answer",
          "status",
          "route",
          "agents",
          "language",
          "request_id",
          "conversation_id",
          "resolution"
        ],
        "title": "MessageResponse"
      },
      "ModelCatalogItem": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Agents"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "parameters": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelParameterSpec"
            },
            "type": "object",
            "title": "Parameters"
          },
          "price": {
            "additionalProperties": true,
            "type": "object",
            "title": "Price"
          },
          "price_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Tier"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "model",
          "agents",
          "capabilities",
          "parameters",
          "price",
          "price_tier",
          "model_version"
        ],
        "title": "ModelCatalogItem"
      },
      "ModelCatalogResponse": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelCatalogItem"
            },
            "type": "array",
            "title": "Models"
          },
          "verified_at": {
            "type": "string",
            "title": "Verified At"
          },
          "sources": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "models",
          "verified_at",
          "sources"
        ],
        "title": "ModelCatalogResponse"
      },
      "ModelParameterSpec": {
        "properties": {
          "type": {
            "type": "string",
            "const": "integer",
            "title": "Type"
          },
          "minimum": {
            "type": "integer",
            "title": "Minimum"
          },
          "maximum_by_agent": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Maximum By Agent"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "documentation_url": {
            "type": "string",
            "title": "Documentation Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "minimum",
          "maximum_by_agent",
          "description",
          "documentation_url"
        ],
        "title": "ModelParameterSpec"
      },
      "ProfileCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "agents": {
            "additionalProperties": true,
            "type": "object",
            "title": "Agents"
          },
          "demo_allowed": {
            "type": "boolean",
            "title": "Demo Allowed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "agents"
        ],
        "title": "ProfileCreateRequest"
      },
      "ProfileDraftRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "agents": {
            "additionalProperties": true,
            "type": "object",
            "title": "Agents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "agents"
        ],
        "title": "ProfileDraftRequest"
      },
      "PublishRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "PublishRequest"
      },
      "Resolution": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "in_progress",
              "awaiting_customer",
              "resolved",
              "handoff"
            ],
            "title": "State"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "customer_confirmed",
                  "tool_verified"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "Resolution"
      },
      "SessionRequest": {
        "properties": {
          "access_key": {
            "type": "string",
            "format": "password",
            "title": "Access Key",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_key"
        ],
        "title": "SessionRequest"
      },
      "Source": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "official",
              "demo_procedure",
              "web",
              "tool"
            ],
